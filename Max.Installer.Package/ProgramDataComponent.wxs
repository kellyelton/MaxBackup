<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
	<Fragment>
		<Property Id="REMOVECONFIG" Value="0" Secure="yes" />
		<Property Id="REMOVELOGS" Value="0" Secure="yes" />

		<!-- Private directory properties stay unset unless cleanup is explicitly requested.
		     Component conditions are not uninstall-time gates. -->
		<SetProperty Id="ConfigCleanupDirectory" Value="[MAXBACKUPDATAFOLDER]"
			Before="RemoveFiles" Sequence="execute"
			Condition="Installed AND REMOVE=&quot;ALL&quot; AND NOT UPGRADINGPRODUCTCODE AND REMOVECONFIG=&quot;1&quot;" />
		<SetProperty Id="LogsCleanupDirectory" Value="[MAXBACKUPLOGSFOLDER]"
			Before="RemoveFiles" Sequence="execute"
			Condition="Installed AND REMOVE=&quot;ALL&quot; AND NOT UPGRADINGPRODUCTCODE AND REMOVELOGS=&quot;1&quot;" />

		<Component Id="ProgramDataFolderComponent" Directory="MAXBACKUPDATAFOLDER" Guid="BE347DD7-26CD-4E54-8EEA-FA9F69BD7C0D">
			<CreateFolder />
			<CreateFolder Directory="MAXBACKUPLOGSFOLDER" />
			<RemoveFile Id="RemoveConfigJson" Name="config.json" Property="ConfigCleanupDirectory" On="uninstall" />
			<RemoveFile Id="RemoveLogFiles" Name="service*.log" Property="LogsCleanupDirectory" On="uninstall" />
		</Component>
	</Fragment>
</Wix>
